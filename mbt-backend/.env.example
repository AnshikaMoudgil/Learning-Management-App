# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configurations
SUPABASE_URL=https://iwzcltjnulmwuhomrsuq.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis Cache & BullMQ Queue (e.g. Upstash or local)
# REDIS_URL=redis://default:password@localhost:6379

# # JWT Configuration
# JWT_SECRET=your-super-secret-jwt-key

# # Dual Payment Gateways (Razorpay)
# # Integration A: Hardware
# RAZORPAY_KEY_ID_A=rzp_test_hardware_key
# RAZORPAY_KEY_SECRET_A=your_hardware_secret
# RAZORPAY_WEBHOOK_SECRET_A=your_hardware_webhook_secret
# # Integration B: Software
# RAZORPAY_KEY_ID_B=rzp_test_software_key
# RAZORPAY_KEY_SECRET_B=your_software_secret
# RAZORPAY_WEBHOOK_SECRET_B=your_software_webhook_secret

# Zoom Server-to-Server OAuth (create at marketplace.zoom.us → Server-to-Server OAuth)
# ZOOM_REDIRECT_URI=https://your-domain.com/zoom/callback
# ZOOM_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key
# ZOOM_CLIENT_ID=your_zoom_client_id
# ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Zoom Meeting SDK (create at marketplace.zoom.us → Meeting SDK)
# ZOOM_SDK_KEY=your_zoom_sdk_key
# ZOOM_SDK_SECRET=your_zoom_sdk_secret

# Zoom Webhook Verification Token (from Zoom app → Feature → Webhooks)
# ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token

# Cloudflare R2 (for recording storage)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name

# Storage Configuration
# STORAGE_PROVIDER=cloudinary # options: cloudinary, r2
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# # Push Notifications (Firebase Cloud Messaging)
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# # Email Integration (SendGrid or AWS SES)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# EMAIL_FROM=noreply@yourdomain.com

# # SMS Provider Integration (Twilio or MSG91)
# SMS_PROVIDER_API_KEY=your_sms_provider_api_key

# # AI Dubbing Pipeline Vendor
# DUBBING_API_KEY=your_dubbing_vendor_api_key
